# ─── Supabase ─────────────────────────────────────────────────────────────────
# Create a project at https://supabase.com and copy these from
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Stripe ───────────────────────────────────────────────────────────────────
# Create an account at https://stripe.com and copy from Developers → API keys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Price IDs — create products in Stripe dashboard
STRIPE_PRO_MONTHLY_PRICE_ID=price_...
STRIPE_PRO_ANNUAL_PRICE_ID=price_...

# ─── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Admin / GDPR ─────────────────────────────────────────────────────────────
# Shared secret used to authenticate calls to /api/admin/purge
# Generate with: openssl rand -hex 32
PURGE_SECRET=your-secret-here
